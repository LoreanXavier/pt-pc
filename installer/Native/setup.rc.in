#include <windows.h>
100 RCDATA "@PT_SETUP_PAYLOAD@"
1 RT_MANIFEST "@PT_SETUP_MANIFEST@"
1 VERSIONINFO
FILEVERSION @PT_SETUP_VERSION_RC@
PRODUCTVERSION @PT_SETUP_VERSION_RC@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "@PT_SETUP_DESCRIPTION@\0"
   VALUE "ProductName", "@PT_SETUP_PRODUCT@\0"
   VALUE "FileVersion", "@PT_SETUP_VERSION@\0"
   VALUE "ProductVersion", "@PT_SETUP_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
