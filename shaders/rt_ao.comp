#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "common.glsl"
#include "rt_shadow.glsl"

// Ray traced ambient occlusion (rendering.md 12.21), the first pass: a few rays per pixel over the hemisphere of the G-buffer
// normal (cosine weighted), against the camera view's G-buffer surfaces (TLAS mask bit 3), up to the reach. Each ray's
// occlusion falls from 1 at the surface to 0 at the reach, (1 - t / reach)^2; the raw value is 1 minus their mean.
// rt_ao_filter.comp accumulates it over frames and blurs it; probe.frag with PT_RT_AO multiplies the probe ambient by it.

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PassPush {
    // x the view, y the frame number, z the rays per pixel
    uvec4 ids;
    // x the reach in metres
    vec4 f0;
    vec4 f1;
    vec4 f2;
    mat4 m;
} pass;

layout(set = 2, binding = 3, r32f) uniform writeonly image2D rt_ao_raw;

vec3 ViewAt(View v, ivec2 pixel) {
    float depth = max(ImgFetch(IMG_DEPTH, pixel).x, 1.0e-7);
    return ViewPosition(v, PixelNdc(v, vec2(pixel) + 0.5), depth);
}

uint Hash(uint x) {
    x ^= x >> 16u;
    x *= 0x7feb352du;
    x ^= x >> 15u;
    x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}

void main() {
    View v = frame.views[pass.ids.x];
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(v.viewport.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    float depth = ImgFetch(IMG_DEPTH, pixel).x;
    if (depth <= 0.0) {
        imageStore(rt_ao_raw, pixel, vec4(1.0));
        return;
    }
    vec3 c = ViewPosition(v, PixelNdc(v, vec2(pixel) + 0.5), depth);
    // the face normal from the depth, on the side whose neighbour is nearer in depth (not across an edge)
    vec3 l = ViewAt(v, max(pixel - ivec2(1, 0), ivec2(0)));
    vec3 r = ViewAt(v, min(pixel + ivec2(1, 0), size - 1));
    vec3 d = ViewAt(v, max(pixel - ivec2(0, 1), ivec2(0)));
    vec3 u = ViewAt(v, min(pixel + ivec2(0, 1), size - 1));
    vec3 dx = abs(r.z - c.z) < abs(c.z - l.z) ? r - c : c - l;
    vec3 dy = abs(u.z - c.z) < abs(c.z - d.z) ? u - c : c - d;
    vec3 face = cross(dx, dy);
    face = dot(face, face) > 0.0 ? normalize(face) : vec3(0.0, 0.0, -1.0);
    if (dot(face, c) > 0.0) {
        face = -face;
    }
    mat3 to_world = mat3(v.inv_view);
    vec3 world = (v.inv_view * vec4(c, 1.0)).xyz;
    vec3 ng = normalize(to_world * face);
    vec3 n = normalize(to_world * DecodeNormal(ImgFetch(IMG_NORMAL, pixel).xyz));
    if (dot(n, ng) < 0.0) {
        n = ng;
    }
    vec3 t = normalize(cross(n, abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    float reach = pass.f0.x;
    vec3 origin = world + ng * max(0.003, 0.0015 * c.z);
    uint rays = max(pass.ids.z, 1u);
    // per pixel a random start, per frame and ray the R2 sequence on from it
    uint seed = Hash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u);
    vec2 start = vec2(float(seed & 0xFFFFu), float(seed >> 16u)) / 65536.0;
    float occlusion = 0.0;
    for (uint i = 0u; i < rays; ++i) {
        float k = float(pass.ids.y * rays + i);
        vec2 e = fract(start + k * vec2(0.7548776662, 0.5698402910));
        float phi = 6.2831853 * e.x;
        float sin_theta = sqrt(e.y);
        vec3 dir = (t * cos(phi) + b * sin(phi)) * sin_theta + n * sqrt(1.0 - e.y);
        // below the face (a normal map tilts n): mirrored into the face's hemisphere
        float below = dot(dir, ng);
        if (below < 0.0) {
            dir -= 2.0 * below * ng;
        }
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, rt_casters, gl_RayFlagsNoneEXT, 8u, origin, 0.0, dir, reach);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
                RtCasterOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false), rayQueryGetIntersectionPrimitiveIndexEXT(rq, false),
                               rayQueryGetIntersectionBarycentricsEXT(rq, false))) {
                rayQueryConfirmIntersectionEXT(rq);
            }
        }
        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            float f = 1.0 - rayQueryGetIntersectionTEXT(rq, true) / reach;
            occlusion += f * f;
        }
    }
    imageStore(rt_ao_raw, pixel, vec4(1.0 - occlusion / float(rays)));
}
